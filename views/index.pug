doctype html
html
    head
        title Quotes
        style. 
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
                font-family: 'Ubuntu';
            }

            body {
                height: 100%;
                width: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: space-around;
            }
            .content {
                margin-top: 15%;
                display: flex;
                flex-direction: column;
                align-items: center;
            }
            #quote {
                //- height: 30%;
                width: 60%;
                padding-left: 20px;
                background: #c5d9d7;
                border-radius: 10px;
                border: 1px solid #9fb5b3;
                font-size: 0.9rem;
            }
            p > em {
                margin-top: 15px;
            }
            em {
                font-weight: 800;
            }
    body 
        div.content 
            p#quote= quote 
            p
                em= author
